{
  "uid":"hacktrain-platform", "title":"HackTrain API health", "schemaVersion":41,
  "time":{"from":"now-1h","to":"now"}, "refresh":"15s",
  "panels":[
    {"id":1,"title":"Requests per second","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum(rate(http_server_requests_seconds_count[5m]))"}]},
    {"id":2,"title":"5xx error ratio","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 0.001)"}]},
    {"id":3,"title":"Average response seconds","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum(rate(http_server_requests_seconds_sum[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 0.001)"}]},
    {"id":4,"title":"Heap used bytes","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum(jvm_memory_used_bytes{area=\"heap\"})"}]}
  ]
}
