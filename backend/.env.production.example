# Copy values into the deployment provider's secret/environment settings.
# Never commit real credentials in this file.
DB_URL=jdbc:postgresql://<postgres-host>:5432/<database>?sslmode=verify-full
DB_USER=hacktrain_runtime
DB_PASSWORD=
MIGRATION_DB_USER=hacktrain_migrator
MIGRATION_DB_PASSWORD=

# Use the current Upstash endpoint and a URI-encoded token.
REDIS_URL=rediss://default:<url-encoded-token>@<upstash-host>:6379

JWT_SECRET=
CORS_ORIGINS=https://your-frontend.example

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
AI_STUDENT_DAILY_LIMIT=30
AI_ORGANIZATION_DAILY_LIMIT=1000
