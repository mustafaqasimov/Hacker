# Local development only. Copy to .env, then generate unique values; never commit .env.
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
GRAFANA_PASSWORD=
CORS_ORIGINS=http://localhost:8080

# Backend-only AI credentials. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_STUDENT_DAILY_LIMIT=30
AI_ORGANIZATION_DAILY_LIMIT=1000

# Select claude or openai
AI_PROVIDER=groq
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
