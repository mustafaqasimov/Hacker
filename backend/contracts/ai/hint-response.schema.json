{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hacktrain:ai:hint-response:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["difficulty", "evidenceAttemptIds", "needsClarification", "clarifyingQuestion", "hintLevel", "hintText", "confidence"],
  "properties": {
    "difficulty": {"type":"string", "minLength":1, "maxLength":500},
    "evidenceAttemptIds": {"type":"array", "maxItems":10, "uniqueItems":true, "items":{"type":"string", "format":"uuid"}},
    "needsClarification": {"type":"boolean"},
    "clarifyingQuestion": {"type":["string","null"], "minLength":1, "maxLength":500},
    "hintLevel": {"type":"integer", "minimum":1, "maximum":3},
    "hintText": {"type":"string", "minLength":1, "maxLength":2000},
    "confidence": {"type":"number", "minimum":0, "maximum":1}
  },
  "allOf": [{
    "if": {"properties":{"needsClarification":{"const":true}}},
    "then": {"properties":{"clarifyingQuestion":{"type":"string","minLength":1}}},
    "else": {"properties":{"clarifyingQuestion":{"type":"null"}}}
  }]
}
